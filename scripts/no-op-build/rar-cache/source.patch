+    private RarResultsEntry? LoadResults(string path)
+    {
+        try
+        {
+            RarFileStamp stamp = RarFileStamp.Read(path);
+            if (!stamp.Exists)
+            {
+                s_resultsCache.TryRemove(path, out _);
+                return null;
+            }
+            if (s_resultsCache.TryGetValue(path, out RarResultsEntry? memory) && memory.CacheStamp == stamp)
+            {
+                return memory;
+            }
+            if (stamp.Length > 64 * 1024 * 1024)
+            {
+                throw new InvalidDataException("RAR result cache exceeds its size limit.");
+            }
+            using var file = File.OpenRead(path);
+            using var header = new BinaryReader(file, Encoding.UTF8, leaveOpen: true);
+            if (header.ReadInt32() != 0x52415243) { throw new InvalidDataException("Invalid RAR cache header."); }
+            int length = header.ReadInt32();
+            if (length is < 0 or > 64 * 1024 * 1024) { throw new InvalidDataException("Invalid decompressed RAR cache size."); }
+            byte[] expectedHash = header.ReadBytes(32);
+            byte[] bytes = new byte[length];
+            using (var compressed = new BrotliStream(file, CompressionMode.Decompress, leaveOpen: true))
+            {
+                compressed.ReadExactly(bytes);
+                if (compressed.ReadByte() != -1) { throw new InvalidDataException("RAR cache exceeds its declared size."); }
+            }
+            if (!expectedHash.AsSpan().SequenceEqual(SHA256.HashData(bytes))) { throw new InvalidDataException("RAR cache integrity check failed."); }
+            using var reader = new BinaryReader(new MemoryStream(bytes, writable: false));
+            RarResultsEntry entry = RarResultsEntry.Read(reader);
+            entry.CacheStamp = stamp;
+            RememberResult(path, entry);
+            return entry;
+        }
+        catch (Exception e) when (e is IOException or UnauthorizedAccessException or ArgumentException or InvalidDataException or InvalidOperationException or FormatException)
+        {
+            Log.LogMessageFromResources(MessageImportance.Low, "General.CouldNotReadStateFileMessage", path, e.Message);
+            s_resultsCache.TryRemove(path, out _);
+            return null;
+        }
+    }
+
+    private bool StoreResults(string path, RarResultsEntry entry)
+    {
+        string temporary = path + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        try
+        {
+            using var payload = new MemoryStream();
+            using (var writer = new BinaryWriter(payload, Encoding.UTF8, leaveOpen: true))
+            {
+                entry.Write(writer);
+            }
+            byte[] bytes = payload.ToArray();
+            if (bytes.Length > 64 * 1024 * 1024) { throw new InvalidDataException("RAR cache exceeds its size limit."); }
+            using (var file = new FileStream(temporary, FileMode.CreateNew, FileAccess.Write, FileShare.None))
+            {
+                using (var header = new BinaryWriter(file, Encoding.UTF8, leaveOpen: true))
+                {
+                    header.Write(0x52415243);
+                    header.Write(bytes.Length);
+                    header.Write(SHA256.HashData(bytes));
+                }
+                using var compressed = new BrotliStream(file, CompressionLevel.Fastest, leaveOpen: true);
+                compressed.Write(bytes);
+            }
+            File.Move(temporary, path, overwrite: true);
+            entry.CacheStamp = RarFileStamp.Read(path);
+            RememberResult(path, entry);
+            return true;
+        }
+        catch (Exception e) when (e is IOException or UnauthorizedAccessException or InvalidDataException)
+        {
+            Log.LogMessageFromResources(MessageImportance.Low, "ResolveAssemblyReference.ResultsCacheStatus", "write-failed", path, e.Message);
+            return false;
+        }
+        finally
+        {
+            if (File.Exists(temporary))
+            {
+                try { File.Delete(temporary); }
+                catch (Exception e) when (e is IOException or UnauthorizedAccessException)
+                {
+                    Log.LogMessageFromResources(MessageImportance.Low, "ResolveAssemblyReference.ResultsCacheStatus", "temporary-cleanup-failed", temporary, e.Message);
+                }
+            }
+        }
+    }
+
+    private static void RememberResult(string path, RarResultsEntry entry)
+    {
+        if (s_resultsCache.Count < 256 || s_resultsCache.ContainsKey(path))
+        {
+            s_resultsCache[path] = entry;
+        }
+    }
+
+    private void RemoveResults(string path)
+    {
+        s_resultsCache.TryRemove(path, out _);
+        try
+        {
+            File.Delete(path);
+        }
+        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
+        {
+            Log.LogMessageFromResources(MessageImportance.Low, "ResolveAssemblyReference.ResultsCacheStatus", "remove-failed", path, e.Message);
+        }
+    }
