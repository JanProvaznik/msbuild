+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+#if NET
+using System;
+using System.IO;
+using Microsoft.Build.Framework;
+using Microsoft.Build.Shared;
+using Microsoft.Build.Tasks;
+using Microsoft.Build.Utilities;
+using Shouldly;
+using Xunit;
+
+namespace Microsoft.Build.UnitTests.ResolveAssemblyReference_Tests;
+
+public sealed class ResolveAssemblyReferenceResultsCache_Tests(ITestOutputHelper output)
+{
+    private readonly ITestOutputHelper _output = output;
+
+    [Fact]
+    public void ResultCacheDoesNotExposeMutablePrototypes()
+    {
+        using TestEnvironment env = TestEnvironment.Create(_output);
+        string state = Path.Combine(env.CreateFolder().Path, "references.cache");
+        ResolveAssemblyReference fill = Create(state);
+        fill.Execute().ShouldBeTrue();
+        fill.ResultsCacheHit.ShouldBeFalse();
+        File.Exists(state + ".results").ShouldBeTrue();
+
+        ResolveAssemblyReference hit = Create(state);
+        hit.Execute().ShouldBeTrue();
+        hit.ResultsCacheHit.ShouldBeTrue();
+        hit.ResolvedFiles.ShouldHaveSingleItem();
+        hit.ResolvedFiles[0].GetMetadata("Custom").ShouldBe("a;b%quoted");
+        hit.ResolvedFiles[0].GetMetadata("RecursiveDir").ShouldBe("sub/");
+        hit.ResolvedFiles[0].GetMetadata("OriginalItemSpec").ShouldBe(fill.ResolvedFiles[0].GetMetadata("OriginalItemSpec"));
+        hit.ResolvedFiles[0].SetMetadata("Custom", "mutated");
+        hit.ResolvedFiles[0].ItemSpec = "mutated.dll";
+
+        ResolveAssemblyReference next = Create(state);
+        next.Execute().ShouldBeTrue();
+        next.ResultsCacheHit.ShouldBeTrue();
+        next.ResolvedFiles[0].ItemSpec.ShouldBe(typeof(object).Assembly.Location);
+        next.ResolvedFiles[0].GetMetadata("Custom").ShouldBe("a;b%quoted");
+        next.ResolvedFiles[0].GetMetadata("RecursiveDir").ShouldBe("sub/");
+    }
+
+    [Fact]
+    public void ResultCacheDistinguishesLegacyEmptyAppConfig()
+    {
+        using TestEnvironment env = TestEnvironment.Create(_output);
+        env.SetEnvironmentVariable("MSBUILDDISABLEFEATURESFROMVERSION", ChangeWaves.Wave18_8.ToString());
+        env.WithTransientTestState(new WaveState());
+        string state = Path.Combine(env.CreateFolder().Path, "references.cache");
+        ResolveAssemblyReference fill = Create(state);
+        fill.FindDependencies = true;
+        fill.Execute().ShouldBeTrue();
+        File.Exists(state + ".results").ShouldBeTrue();
+
+        ResolveAssemblyReference hit = Create(state);
+        hit.FindDependencies = true;
+        hit.Execute().ShouldBeTrue();
+        hit.ResultsCacheHit.ShouldBeTrue();
+
+        ResolveAssemblyReference empty = Create(state);
+        empty.FindDependencies = true;
+        empty.AppConfigFile = string.Empty;
+        empty.AppConfigFile.ShouldBe(fill.AppConfigFile);
+        empty.Execute().ShouldBeFalse();
+        empty.ResultsCacheHit.ShouldBeFalse();
+        ((MockEngine)empty.BuildEngine).Errors.ShouldBe(1);
+    }
+
+    [Fact]
+    public void ResultCacheIsDisabledByDefault()
+    {
+        using TestEnvironment env = TestEnvironment.Create(_output);
+        string state = Path.Combine(env.CreateFolder().Path, "references.cache");
+        ResolveAssemblyReference task = Create(state);
+        task.EnableResultsCache = false;
+        task.Execute().ShouldBeTrue();
+        task.ResultsCacheHit.ShouldBeFalse();
+        File.Exists(state + ".results").ShouldBeFalse();
+        new ResolveAssemblyReference().EnableResultsCache.ShouldBeFalse();
+    }
+
+    private ResolveAssemblyReference Create(string state)
+    {
+        var item = new TaskItem(typeof(object).Assembly.Location);
+        ((ITaskItem2)item).SetMetadataValueLiteral("Custom", "a;b%quoted");
+        item.SetMetadata("RecursiveDir", "sub/");
+        return new ResolveAssemblyReference
+        {
+            BuildEngine = new MockEngine(_output),
+            Assemblies = [item],
+            SearchPaths = ["{RawFileName}"],
+            FindDependencies = false,
+            FindRelatedFiles = false,
+            FindSatellites = false,
+            FindSerializationAssemblies = false,
+            StateFile = state,
+            EnableResultsCache = true
+        };
+    }
+
+    private sealed class WaveState : TransientTestState
+    {
+        public WaveState() => ChangeWaves.ResetStateForTests();
+        public override void Revert() => ChangeWaves.ResetStateForTests();
+    }
+}
+#endif
