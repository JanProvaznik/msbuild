+    private readonly record struct RarFileStamp(bool Exists, long Ticks, long Length, int Attributes)
+    {
+        internal static RarFileStamp Read(string path)
+        {
+            var file = new FileInfo(path);
+            file.Refresh();
+            return Read(file);
+        }
+
+        internal static RarFileStamp Read(FileInfo file)
+        {
+            return file.Exists
+                ? new(true, file.LastWriteTimeUtc.Ticks, file.Length, (int)file.Attributes)
+                : new(false, 0, 0, 0);
+        }
+
+        internal void Write(BinaryWriter writer)
+        {
+            writer.Write(Exists);
+            writer.Write(Ticks);
+            writer.Write(Length);
+            writer.Write(Attributes);
+        }
+
+        internal static RarFileStamp Read(BinaryReader reader) =>
+            new(reader.ReadBoolean(), reader.ReadInt64(), reader.ReadInt64(), reader.ReadInt32());
+    }
+
+    private sealed class RarResultsObservations
+    {
+        internal readonly Dictionary<string, RarFileStamp> Files = new(s_resultPathComparer);
+        internal readonly Dictionary<string, bool> Directories = new(s_resultPathComparer);
+        internal readonly HashSet<string> RequiredFiles = new(s_resultPathComparer);
+        internal readonly Dictionary<(string Path, string Pattern), string[]> Enumerations = [];
+        internal bool Cacheable = true;
+        private readonly string _projectDirectory;
+        private readonly string _stateFile;
+        private readonly string _cacheFile;
+
+        internal RarResultsObservations(string projectDirectory, string stateFile, string cacheFile)
+        {
+            _projectDirectory = projectDirectory;
+            _stateFile = stateFile;
+            _cacheFile = cacheFile;
+        }
+
+        private string Absolute(string path) => new AbsolutePath(path, new AbsolutePath(_projectDirectory)).GetCanonicalForm().Value;
+
+        internal void ObserveFile(string path)
+        {
+            try
+            {
+                string absolute = Absolute(path);
+                if (s_resultPathComparer.Equals(absolute, _stateFile) || s_resultPathComparer.Equals(absolute, _cacheFile))
+                {
+                    return;
+                }
+                if (!Files.ContainsKey(absolute))
+                {
+                    RarFileStamp stamp = RarFileStamp.Read(absolute);
+                    if ((stamp.Attributes & (int)FileAttributes.ReparsePoint) != 0)
+                    {
+                        Cacheable = false;
+                    }
+                    Files.Add(absolute, stamp);
+                }
+            }
+            catch (Exception e) when (e is IOException or UnauthorizedAccessException or ArgumentException or NotSupportedException)
+            {
+                Cacheable = false;
+            }
+        }
+
+        internal void ObserveFinalFile(string path)
+        {
+            string absolute = Absolute(path);
+            if (s_resultPathComparer.Equals(absolute, _stateFile))
+            {
+                RequiredFiles.Add(absolute);
+            }
+            else if (!s_resultPathComparer.Equals(absolute, _cacheFile))
+            {
+                Files[absolute] = RarFileStamp.Read(absolute);
+            }
+        }
+
+        internal FileExists Wrap(FileExists original) => path =>
+        {
+            ObserveFile(path);
+            return original(path);
+        };
+
+        internal GetLastWriteTime Wrap(GetLastWriteTime original) => path =>
+        {
+            ObserveFile(path);
+            if (Files.TryGetValue(Absolute(path), out RarFileStamp stamp))
+            {
+                // NativeMethodsShared can itself memoize immutable-file timestamps. Cacheable
+                // resolution must consume the same real file generation that we validate.
+                return stamp.Exists ? new DateTime(stamp.Ticks, DateTimeKind.Utc) : DateTime.MinValue;
+            }
+            return original(path);
+        };
+
+        internal DirectoryExists Wrap(DirectoryExists original) => path =>
+        {
+            bool exists = original(path);
+            Directories.TryAdd(Absolute(path), exists);
+            return exists;
+        };
+
+        internal GetDirectories Wrap(GetDirectories original) => (path, pattern) =>
+        {
+            string[] result = original(path, pattern);
+            Enumerations.TryAdd((Absolute(path), pattern), (string[])result.Clone());
+            return result;
+        };
+
+        internal string? Difference()
+        {
+            try
+            {
+                return DifferenceCore();
+            }
+            catch (Exception e) when (e is IOException or UnauthorizedAccessException)
+            {
+                return "filesystem-read: " + e.Message;
+            }
+        }
+
+        private string? DifferenceCore()
+        {
+            if (!Cacheable) { return "unobservable-path"; }
+            foreach (string required in RequiredFiles)
+            {
+                if (!File.Exists(required)) { return "required-output: " + required; }
+            }
+            var groups = new Dictionary<string, List<KeyValuePair<string, RarFileStamp>>>(s_resultPathComparer);
+            foreach (var file in Files)
+            {
+                string directory = Path.GetDirectoryName(file.Key)!;
+                if (!groups.TryGetValue(directory, out var group))
+                {
+                    group = [];
+                    groups.Add(directory, group);
+                }
+                group.Add(file);
+            }
+            foreach (var group in groups)
+            {
+                string? difference = CheckFiles(group.Key, group.Value);
+                if (difference is not null) { return difference; }
+            }
+            foreach (var directory in Directories)
+            {
+                if (Directory.Exists(directory.Key) != directory.Value) { return "directory: " + directory.Key; }
+            }
+            foreach (var enumeration in Enumerations)
+            {
+                if (!Directory.Exists(enumeration.Key.Path)) { return "directory-enumeration: " + enumeration.Key.Path; }
+                string[] current = Directory.GetDirectories(enumeration.Key.Path, enumeration.Key.Pattern);
+                Array.Sort(current, StringComparer.Ordinal);
+                if (!current.AsSpan().SequenceEqual(enumeration.Value)) { return "directory-enumeration: " + enumeration.Key.Path; }
+            }
+            return null;
+        }
+
+        private string? CheckFiles(string directory, List<KeyValuePair<string, RarFileStamp>> files)
+        {
+            // Directory enumeration supplies timestamps, sizes and attributes in a single OS batch.
+            // Only queried paths are compared; absent queried paths still invalidate when they appear.
+            if (files.Count >= 8 && Directory.Exists(directory))
+            {
+                try
+                {
+                    int remaining = 0;
+                    var expected = new Dictionary<string, RarFileStamp>(files.Count, s_resultPathComparer);
+                    foreach (var file in files)
+                    {
+                        expected.Add(file.Key, file.Value);
+                        if (file.Value.Exists) { remaining++; }
+                    }
+                    foreach (FileInfo file in new DirectoryInfo(directory).EnumerateFiles())
+                    {
+                        if (expected.TryGetValue(file.FullName, out RarFileStamp stamp))
+                        {
+                            if (RarFileStamp.Read(file) != stamp) { return "file: " + file.FullName; }
+                            if (stamp.Exists) { remaining--; }
+                        }
+                    }
+                    if (remaining == 0) { return null; }
+                }
+                catch (Exception e) when (e is IOException or UnauthorizedAccessException)
+                {
+                    // Listing a directory can be forbidden while statting its known files is allowed.
+                    // Fall back to the original per-path checks rather than accepting an unverified hit.
+                }
+            }
+            foreach (var file in files)
+            {
+                if (RarFileStamp.Read(file.Key) != file.Value) { return "file: " + file.Key; }
+            }
+            return null;
+        }
+
+        internal void Write(BinaryWriter writer)
+        {
+            writer.Write(_projectDirectory);
+            writer.Write(_stateFile);
+            writer.Write(_cacheFile);
+            writer.Write(RequiredFiles.Count);
+            foreach (string required in RequiredFiles) { writer.Write(required); }
+            writer.Write(Files.Count);
+            foreach (var file in Files) { writer.Write(file.Key); file.Value.Write(writer); }
+            writer.Write(Directories.Count);
+            foreach (var directory in Directories) { writer.Write(directory.Key); writer.Write(directory.Value); }
+            writer.Write(Enumerations.Count);
+            foreach (var enumeration in Enumerations)
+            {
+                writer.Write(enumeration.Key.Path);
+                writer.Write(enumeration.Key.Pattern);
+                writer.Write(enumeration.Value.Length);
+                foreach (string path in enumeration.Value) { writer.Write(path); }
+            }
+        }
+
+        internal static RarResultsObservations Read(BinaryReader reader)
+        {
+            var result = new RarResultsObservations(reader.ReadString(), reader.ReadString(), reader.ReadString());
+            int required = ReadCount(reader);
+            for (int i = 0; i < required; i++) { result.RequiredFiles.Add(reader.ReadString()); }
+            int files = ReadCount(reader);
+            for (int i = 0; i < files; i++) { result.Files.Add(reader.ReadString(), RarFileStamp.Read(reader)); }
+            int directories = ReadCount(reader);
+            for (int i = 0; i < directories; i++) { result.Directories.Add(reader.ReadString(), reader.ReadBoolean()); }
+            int enumerations = ReadCount(reader);
+            for (int i = 0; i < enumerations; i++)
+            {
+                var key = (reader.ReadString(), reader.ReadString());
+                string[] paths = new string[ReadCount(reader)];
+                for (int j = 0; j < paths.Length; j++) { paths[j] = reader.ReadString(); }
+                result.Enumerations.Add(key, paths);
+            }
+            return result;
+        }
+    }
