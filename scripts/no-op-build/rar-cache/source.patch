+    private sealed record RarCachedMessage(string? Message, string? Help, string? Sender, MessageImportance Importance,
+        string? Subcategory, string? Code, string? File, int Line, int Column, int EndLine, int EndColumn)
+    {
+        internal static RarCachedMessage From(BuildMessageEventArgs e) =>
+            new(e.Message, e.HelpKeyword, e.SenderName, e.Importance,
+                e.Subcategory, e.Code, e.File, e.LineNumber, e.ColumnNumber, e.EndLineNumber, e.EndColumnNumber);
+        internal BuildMessageEventArgs CreateEvent() =>
+            new(Subcategory, Code, File, Line, Column, EndLine, EndColumn, Message, Help, Sender, Importance);
+        internal void Write(BinaryWriter writer)
+        {
+            WriteString(writer, Message); WriteString(writer, Help); WriteString(writer, Sender); writer.Write((int)Importance);
+            WriteString(writer, Subcategory); WriteString(writer, Code); WriteString(writer, File);
+            writer.Write(Line); writer.Write(Column); writer.Write(EndLine); writer.Write(EndColumn);
+        }
+        internal static RarCachedMessage Read(BinaryReader reader) =>
+            new(ReadString(reader), ReadString(reader), ReadString(reader), (MessageImportance)reader.ReadInt32(),
+                ReadString(reader), ReadString(reader), ReadString(reader), reader.ReadInt32(), reader.ReadInt32(), reader.ReadInt32(), reader.ReadInt32());
+        private static void WriteString(BinaryWriter writer, string? value)
+        {
+            writer.Write(value is not null);
+            if (value is not null) { writer.Write(value); }
+        }
+        private static string? ReadString(BinaryReader reader) => reader.ReadBoolean() ? reader.ReadString() : null;
+    }
+
+    private sealed class RarResultsEntry(string signature, RarResultsObservations observations, byte[] outputs, RarCachedMessage[] messages)
+    {
+        private readonly object _outputLock = new();
+        private Dictionary<string, object>? _outputPrototypes;
+        internal string Signature { get; } = signature;
+        internal RarResultsObservations Observations { get; } = observations;
+        internal byte[] Outputs { get; } = outputs;
+        internal RarCachedMessage[] Messages { get; } = messages;
+        internal RarFileStamp CacheStamp { get; set; }
+        internal Dictionary<string, object> GetOutputPrototypes(ResolveAssemblyReference task)
+        {
+            lock (_outputLock)
+            {
+                return _outputPrototypes ??= task.ReadOutputPrototypes(Outputs);
+            }
+        }
+        internal void Write(BinaryWriter writer)
+        {
+            writer.Write("MSBuild.RAR.Results");
+            writer.Write(5);
+            writer.Write(Signature);
+            Observations.Write(writer);
+            writer.Write(Outputs.Length);
+            writer.Write(SHA256.HashData(Outputs));
+            writer.Write(Outputs);
+            writer.Write(Messages.Length);
+            foreach (RarCachedMessage message in Messages) { message.Write(writer); }
+        }
+        internal static RarResultsEntry Read(BinaryReader reader)
+        {
+            if (reader.ReadString() != "MSBuild.RAR.Results" || reader.ReadInt32() != 5)
+            {
+                throw new InvalidDataException("Unsupported RAR result cache format.");
+            }
+            string key = reader.ReadString();
+            RarResultsObservations observations = RarResultsObservations.Read(reader);
+            int size = reader.ReadInt32();
+            if (size < 0 || size > 64 * 1024 * 1024) { throw new InvalidDataException("Invalid RAR output size."); }
+            byte[] checksum = reader.ReadBytes(32);
+            byte[] bytes = reader.ReadBytes(size);
+            if (bytes.Length != size) { throw new EndOfStreamException(); }
+            if (!checksum.AsSpan().SequenceEqual(SHA256.HashData(bytes))) { throw new InvalidDataException("Invalid RAR output checksum."); }
+            var messages = new RarCachedMessage[ReadCount(reader)];
+            for (int i = 0; i < messages.Length; i++) { messages[i] = RarCachedMessage.Read(reader); }
+            return new(key, observations, bytes, messages);
+        }
+    }
+
+    private static int ReadCount(BinaryReader reader)
+    {
+        int count = reader.ReadInt32();
+        return count is >= 0 and <= 1_000_000 ? count : throw new InvalidDataException("Invalid RAR cache collection size.");
+    }
