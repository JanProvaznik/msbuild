+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+using Microsoft.Build.Framework;
+
+#if NET
+using System;
+using System.Collections;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.Globalization;
+using System.IO;
+using System.IO.Compression;
+using System.Security.Cryptography;
+using System.Text;
+using Microsoft.Build.BackEnd;
+using Microsoft.Build.Shared;
+using Microsoft.Build.Tasks.AssemblyDependency;
+using Microsoft.Build.Utilities;
+#endif
+
+#nullable enable
+
+namespace Microsoft.Build.Tasks;
+
+public partial class ResolveAssemblyReference
+{
+    /// <summary>
+    /// Enables an experimental complete-result cache for file-based reference resolution.
+    /// Unsupported resolution environments continue to execute normally.
+    /// </summary>
+    public bool EnableResultsCache { get; set; }
+
+    /// <summary>
+    /// Whether this invocation restored a verified result rather than resolving references.
+    /// </summary>
+    [Output]
+    public bool ResultsCacheHit { get; set; }
+
+#if NET
+    private RarResultsObservations? _resultsCacheObservations;
+    private static readonly StringComparer s_resultPathComparer =
+        OperatingSystem.IsWindows() ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal;
+    private static readonly ConcurrentDictionary<string, RarResultsEntry> s_resultsCache = new(s_resultPathComparer);
+
+    private bool ExecuteWithResultsCache()
+    {
+        ResultsCacheHit = false;
+        if (BuildEngine is not IBuildEngine10 engine || !CanUseResultsCache())
+        {
+            Log.LogMessageFromResources(MessageImportance.Low, "ResolveAssemblyReference.ResultsCacheStatus", "bypass", StateFile, "unsupported-resolution-contract");
+            // Do not accidentally enable result caching in the out-of-proc task after the client
+            // has declined the contract. The request serializer forwards public task inputs.
+            EnableResultsCache = false;
+            try { return ExecuteWithoutResultsCache(); }
+            finally { EnableResultsCache = true; }
+        }
+
+        string cachePath = TaskEnvironment.GetAbsolutePath(StateFile + ".results").Value;
+        string statePath = TaskEnvironment.GetAbsolutePath(StateFile).Value;
+        var timer = Stopwatch.StartNew();
+        string signature;
+        try { signature = GetResultsSignature(engine); }
+        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
+        {
+            Log.LogMessageFromResources(MessageImportance.Low, "ResolveAssemblyReference.ResultsCacheStatus", "bypass", cachePath, e.Message);
+            return ExecuteWithoutResultsCache();
+        }
+        double signatureMs = timer.Elapsed.TotalMilliseconds;
+        RarResultsEntry? previous = LoadResults(cachePath);
+        double loadMs = timer.Elapsed.TotalMilliseconds - signatureMs;
+        string? mismatch = previous is null ? "no-entry"
+            : previous.Signature != signature ? "input-fingerprint"
+            : previous.Observations.Difference();
+
+        double validationMs = timer.Elapsed.TotalMilliseconds - signatureMs - loadMs;
+        if (mismatch is null && previous is not null)
+        {
+            try { RestoreResultOutputs(previous); }
+            catch (Exception e) when (e is IOException or ArgumentException or InvalidDataException or InvalidOperationException or FormatException)
+            {
+                mismatch = "invalid-output-payload: " + e.Message;
+                RemoveResults(cachePath);
+            }
+        }
+        if (mismatch is null && previous is not null)
+        {
+            double restoreMs = timer.Elapsed.TotalMilliseconds - signatureMs - loadMs - validationMs;
+            ResultsCacheHit = true;
+            foreach (RarCachedMessage message in previous.Messages)
+            {
+                engine.LogMessageEvent(message.CreateEvent());
+            }
+            _filesWritten.Add(new TaskItem(cachePath));
+            Log.LogMessageFromResources(MessageImportance.Low, "ResolveAssemblyReference.ResultsCacheStatus", "hit", cachePath,
+                $"{previous.Observations.Files.Count} files; {previous.Observations.Directories.Count} directories; signature-ms={signatureMs:F3}; load-ms={loadMs:F3}; validate-ms={validationMs:F3}; restore-ms={restoreMs:F3}; total-ms={timer.Elapsed.TotalMilliseconds:F3}");
+            return true;
+        }
+
+        Log.LogMessageFromResources(MessageImportance.Low, "ResolveAssemblyReference.ResultsCacheStatus", "miss", cachePath, mismatch);
+        var observations = new RarResultsObservations(TaskEnvironment.ProjectDirectory.Value, statePath, cachePath);
+        SeedResultInputs(observations);
+        var recorder = new RarResultLoggingEngine(engine);
+        BuildEngine = recorder;
+        _resultsCacheObservations = observations;
+        bool success;
+        try
+        {
+            success = ExecuteWithoutResultsCache();
+        }
+        finally
+        {
+            _resultsCacheObservations = null;
+            BuildEngine = engine;
+        }
+
+        if (!success || !recorder.Cacheable)
+        {
+            RemoveResults(cachePath);
+            Log.LogMessageFromResources(MessageImportance.Low, "ResolveAssemblyReference.ResultsCacheStatus", "not-stored", cachePath, "failure-or-diagnostics");
+            return success;
+        }
+
+        // The legacy metadata cache is not a semantic input to a verified result. A normal RAR
+        // invocation may rewrite it (including immutable markers) without changing any assembly.
+        foreach (ITaskItem file in FilesWritten)
+        {
+            observations.ObserveFinalFile(TaskEnvironment.GetAbsolutePath(file.ItemSpec).Value);
+        }
+        string? changed = observations.Difference();
+        bool inputsUnchanged;
+        try { inputsUnchanged = GetResultsSignature(engine) == signature; }
+        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
+        {
+            inputsUnchanged = false;
+            changed = "input-reread: " + e.Message;
+        }
+        if (!observations.Cacheable || changed is not null || !inputsUnchanged)
+        {
+            RemoveResults(cachePath);
+            Log.LogMessageFromResources(MessageImportance.Low, "ResolveAssemblyReference.ResultsCacheStatus", "not-stored", cachePath, changed ?? "unobservable-path");
+            return success;
+        }
+
+        var entry = new RarResultsEntry(signature, observations, SerializeResultOutputs(), recorder.Messages.ToArray());
+        if (StoreResults(cachePath, entry))
+        {
+            _filesWritten.Add(new TaskItem(cachePath));
+        }
+        return success;
+    }
+
+    private bool CanUseResultsCache()
+    {
+        if (string.IsNullOrEmpty(StateFile) || FailIfNotIncremental || AllowOutOfProcNode ||
+            TargetFrameworkDirectories?.Length > 0 || InstalledAssemblyTables?.Length > 0 ||
+            InstalledAssemblySubsetTables?.Length > 0 || FullFrameworkAssemblyTables?.Length > 0 ||
+            FullFrameworkFolders?.Length > 0 || ResolvedSDKReferences?.Length > 0 ||
+            AssemblyInformationCachePaths?.Length > 0 || !string.IsNullOrEmpty(AssemblyInformationCacheOutputPath) ||
+            !string.IsNullOrEmpty(ProfileName) || SearchPaths is null || EnableCustomCulture)
+        {
+            return false;
+        }
+
+        foreach (string path in SearchPaths)
+        {
+            if (path.StartsWith('{') &&
+                !path.Equals("{CandidateAssemblyFiles}", StringComparison.OrdinalIgnoreCase) &&
+                !path.Equals("{HintPathFromItem}", StringComparison.OrdinalIgnoreCase) &&
+                !path.Equals("{RawFileName}", StringComparison.OrdinalIgnoreCase) &&
+                !path.Equals("{TargetFrameworkDirectory}", StringComparison.OrdinalIgnoreCase))
+            {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private string GetResultsSignature(IBuildEngine10 engine)
+    {
+        using var stream = new MemoryStream();
+        using (var writer = new BinaryWriter(stream, Encoding.UTF8, leaveOpen: true))
+        {
+            writer.Write(typeof(ResolveAssemblyReference).Module.ModuleVersionId.ToString());
+            writer.Write(typeof(ITaskItem).Module.ModuleVersionId.ToString());
+            writer.Write(typeof(TaskItem).Module.ModuleVersionId.ToString());
+            writer.Write(TaskEnvironment.ProjectDirectory.Value);
+            writer.Write(_appConfigValueIsEmptyString);
+            writer.Write(CultureInfo.CurrentCulture.Name);
+            writer.Write(CultureInfo.CurrentUICulture.Name);
+            writer.Write(Environment.Version.ToString());
+            foreach (string option in new[] { "System.Globalization.Invariant", "System.Globalization.PredefinedCulturesOnly", "System.Globalization.UseNls" })
+            {
+                writer.Write(AppContext.TryGetSwitch(option, out bool enabled));
+                writer.Write(enabled);
+            }
+            writer.Write(engine.EngineServices.IsTaskInputLoggingEnabled);
+            writer.Write(engine.EngineServices.LogsMessagesOfImportance(MessageImportance.Low));
+            writer.Write(engine.EngineServices.LogsMessagesOfImportance(MessageImportance.Normal));
+            writer.Write(engine.LineNumberOfTaskNode);
+            writer.Write(engine.ColumnNumberOfTaskNode);
+            writer.Write(engine.ProjectFileOfTaskNode ?? "");
+            // Only the digest persists; environment values are never written to the cache.
+            IReadOnlyDictionary<string, string> environment = TaskEnvironment.GetEnvironmentVariables();
+            string[] names = new string[environment.Count];
+            int index = 0;
+            foreach (string name in environment.Keys) { names[index++] = name; }
+            Array.Sort(names, StringComparer.Ordinal);
+            foreach (string name in names)
+            {
+                writer.Write(name);
+                writer.Write(environment[name]);
+            }
+        }
+        using (var writer = new BinaryWriter(stream, Encoding.UTF8, leaveOpen: true))
+        {
+            var inputs = RarTaskParameters.GetInputValues(this);
+            string[] names = new string[inputs.Count];
+            inputs.Keys.CopyTo(names, 0);
+            Array.Sort(names, StringComparer.Ordinal);
+            foreach (string name in names)
+            {
+                writer.Write(name);
+                WriteInput(writer, inputs[name]);
+            }
+        }
+        // App.config is parsed fresh by RAR, not through the timestamp-based assembly metadata cache.
+        // Its small semantic input must also invalidate when edited with preserved timestamps.
+        if (!string.IsNullOrEmpty(AppConfigFile))
+        {
+            string config = TaskEnvironment.GetAbsolutePath(AppConfigFile).Value;
+            if (File.Exists(config))
+            {
+                using FileStream file = File.OpenRead(config);
+                stream.Write(SHA256.HashData(file));
+            }
+        }
+        return Convert.ToHexString(SHA256.HashData(stream.ToArray()));
+    }
+
+    private static void WriteInput(BinaryWriter writer, object? value)
+    {
+        if (value is null) { writer.Write((byte)0); return; }
+        if (value is string text) { writer.Write((byte)1); writer.Write(text); return; }
+        if (value is Array array)
+        {
+            writer.Write((byte)2);
+            writer.Write(array.Length);
+            foreach (object? item in array) { WriteInput(writer, item); }
+            return;
+        }
+        if (value is ITaskItem itemValue)
+        {
+            writer.Write((byte)3);
+            var item = itemValue as ITaskItem2;
+            writer.Write(item?.EvaluatedIncludeEscaped ?? EscapingUtilities.Escape(itemValue.ItemSpec));
+            writer.Write(item?.GetMetadataValueEscaped(ItemSpecModifiers.DefiningProjectFullPath) ?? EscapingUtilities.Escape(itemValue.GetMetadata(ItemSpecModifiers.DefiningProjectFullPath)));
+            writer.Write(item?.GetMetadataValueEscaped(ItemSpecModifiers.RecursiveDir) ?? EscapingUtilities.Escape(itemValue.GetMetadata(ItemSpecModifiers.RecursiveDir)));
+            IDictionary metadata = item?.CloneCustomMetadataEscaped() ?? itemValue.CloneCustomMetadata();
+            string[] names = new string[metadata.Count];
+            metadata.Keys.CopyTo(names, 0);
+            Array.Sort(names, StringComparer.Ordinal);
+            writer.Write(names.Length);
+            foreach (string name in names)
+            {
+                writer.Write(name);
+                string metadataValue = (string?)metadata[name] ?? "";
+                writer.Write(item is null ? EscapingUtilities.Escape(metadataValue) : metadataValue);
+            }
+            return;
+        }
+        writer.Write((byte)4);
+        writer.Write(value.GetType().FullName ?? "");
+        writer.Write(Convert.ToString(value, CultureInfo.InvariantCulture) ?? "");
+    }
+
+    private void SeedResultInputs(RarResultsObservations observations)
+    {
+        ObserveItems(Assemblies ?? []);
+        ObserveItems(AssemblyFiles ?? []);
+        // Candidate names are part of the input fingerprint. Their contents matter only if a
+        // resolver probes them; those positive/negative probes are recorded by the delegates.
+        if (!string.IsNullOrEmpty(AppConfigFile))
+        {
+            observations.ObserveFile(AppConfigFile);
+        }
+
+        void ObserveItems(ITaskItem[] items)
+        {
+            foreach (ITaskItem item in items)
+            {
+                observations.ObserveFile(item.ItemSpec);
+                string hint = item.GetMetadata("HintPath");
+                if (hint.Length != 0) { observations.ObserveFile(hint); }
+            }
+        }
+    }
+
+    private byte[] SerializeResultOutputs()
+    {
+        var outputs = RarTaskParameters.Get(RarTaskParameters.ParameterType.Output, this);
+        outputs[nameof(CopyLocalFiles)] = new TaskParameter(CopyLocalFiles);
+        outputs[nameof(FilesWritten)] = new TaskParameter(FilesWritten);
+        var inputs = new Dictionary<string, (bool AssemblyFile, int Index, ITaskItem Item)>(StringComparer.Ordinal);
+        AddInputs(Assemblies, false);
+        AddInputs(AssemblyFiles, true);
+        var references = new List<(string Output, int Index, bool AssemblyFile, int Input, string[] Removed)>();
+        foreach (string name in new List<string>(outputs.Keys))
+        {
+            if (outputs[name].WrappedParameter is not ITaskItem[] items) { continue; }
+            var reduced = (ITaskItem[])MaterializeResult(items);
+            for (int i = 0; i < items.Length; i++)
+            {
+                string original = items[i].GetMetadata("OriginalItemSpec");
+                if (!inputs.TryGetValue(original, out var input) && !inputs.TryGetValue(items[i].ItemSpec, out input)) { continue; }
+                var basis = new TaskItem(input.Item);
+                if (basis.GetMetadata(ItemSpecModifiers.DefiningProjectFullPath) != items[i].GetMetadata(ItemSpecModifiers.DefiningProjectFullPath)) { continue; }
+                IDictionary baseline = ((ITaskItem2)basis).CloneCustomMetadataEscaped();
+                IDictionary actual = ((ITaskItem2)items[i]).CloneCustomMetadataEscaped();
+                var removed = new List<string>();
+                var unchanged = new List<string>();
+                foreach (DictionaryEntry entry in baseline)
+                {
+                    string key = (string)entry.Key;
+                    if (!actual.Contains(key)) { removed.Add(key); }
+                    else if (string.Equals((string?)actual[key], (string?)entry.Value, StringComparison.Ordinal))
+                    {
+                        unchanged.Add(key);
+                    }
+                }
+                // RecursiveDir is stored metadata but the public removal API rejects it.
+                ((IMetadataContainer)reduced[i]).RemoveMetadataRange(unchanged);
+                references.Add((name, i, input.AssemblyFile, input.Index, removed.ToArray()));
+            }
+            outputs[name] = new TaskParameter(reduced);
+        }
+        using var stream = new MemoryStream();
+        using (var writer = new BinaryWriter(stream, Encoding.UTF8, leaveOpen: true))
+        {
+            writer.Write(references.Count);
+            foreach (var reference in references)
+            {
+                writer.Write(reference.Output); writer.Write(reference.Index);
+                writer.Write(reference.AssemblyFile); writer.Write(reference.Input);
+                writer.Write(reference.Removed.Length);
+                foreach (string key in reference.Removed) { writer.Write(key); }
+            }
+        }
+        BinaryTranslator.GetWriteTranslator(stream).TranslateDictionary(ref outputs, StringComparer.Ordinal, TaskParameter.FactoryForDeserialization);
+        return stream.ToArray();
+
+        void AddInputs(ITaskItem[]? items, bool assemblyFile)
+        {
+            if (items is null) { return; }
+            for (int i = 0; i < items.Length; i++)
+            {
+                inputs.TryAdd(items[i].ItemSpec, (assemblyFile, i, items[i]));
+            }
+        }
+    }
+
+    private void RestoreResultOutputs(RarResultsEntry entry)
+    {
+        Dictionary<string, object> prototypes = entry.GetOutputPrototypes(this);
+        var outputs = new Dictionary<string, object>(prototypes.Count, StringComparer.Ordinal);
+        foreach (var value in prototypes)
+        {
+            outputs.Add(value.Key, MaterializeResult(value.Value));
+        }
+        RarTaskParameters.SetOutputValues(this, outputs);
+        CopyLocalFiles = (ITaskItem[])outputs[nameof(CopyLocalFiles)];
+        _filesWritten.AddRange((ITaskItem[])outputs[nameof(FilesWritten)]);
+    }
+
+    private Dictionary<string, object> ReadOutputPrototypes(byte[] payload)
+    {
+        using var stream = new MemoryStream(payload, 0, payload.Length, writable: false, publiclyVisible: true);
+        var references = new List<(string Output, int Index, bool AssemblyFile, int Input, string[] Removed)>();
+        using (var reader = new BinaryReader(stream, Encoding.UTF8, leaveOpen: true))
+        {
+            int count = ReadCount(reader);
+            for (int i = 0; i < count; i++)
+            {
+                string name = reader.ReadString();
+                int output = reader.ReadInt32();
+                bool assemblyFile = reader.ReadBoolean();
+                int input = reader.ReadInt32();
+                string[] removed = new string[ReadCount(reader)];
+                for (int j = 0; j < removed.Length; j++) { removed[j] = reader.ReadString(); }
+                references.Add((name, output, assemblyFile, input, removed));
+            }
+        }
+        using var translator = BinaryTranslator.GetReadTranslator(stream, InterningBinaryReader.PoolingBuffer);
+        Dictionary<string, TaskParameter> outputs = null!;
+        translator.TranslateDictionary(ref outputs, StringComparer.Ordinal, TaskParameter.FactoryForDeserialization);
+        // The engine has a fast output-transfer path for TaskItem. Leaving the transport wrapper
+        // here forces per-metadata access and can make a cache hit slower than actual resolution.
+        var result = new Dictionary<string, object>(outputs.Count, StringComparer.Ordinal);
+        foreach (var output in outputs) { result.Add(output.Key, MaterializeResult(output.Value.WrappedParameter)); }
+        foreach (var reference in references)
+        {
+            ITaskItem[] inputs = (reference.AssemblyFile ? AssemblyFiles : Assemblies) ?? [];
+            if ((uint)reference.Input >= (uint)inputs.Length ||
+                !result.TryGetValue(reference.Output, out object? value) || value is not ITaskItem[] items ||
+                (uint)reference.Index >= (uint)items.Length)
+            {
+                throw new InvalidDataException("Invalid RAR input-metadata reference.");
+            }
+            var item = new TaskItem(inputs[reference.Input]);
+            item.ItemSpec = ((ITaskItem2)items[reference.Index]).EvaluatedIncludeEscaped;
+            ((IMetadataContainer)item).RemoveMetadataRange(reference.Removed);
+            foreach (DictionaryEntry metadata in ((ITaskItem2)items[reference.Index]).CloneCustomMetadataEscaped())
+            {
+                item.SetMetadata((string)metadata.Key, (string)metadata.Value!);
+            }
+            items[reference.Index] = item;
+        }
+        return result;
+    }
+
+    private static object MaterializeResult(object value)
+    {
+        if (value is ITaskItem[] items)
+        {
+            var result = new ITaskItem[items.Length];
+            for (int i = 0; i < items.Length; i++)
+            {
+                var item = new TaskItem(items[i]);
+                // CopyMetadataTo treats OriginalItemSpec specially. Restore the recorded value,
+                // not the normalized transport item's identity.
+                string original = ((ITaskItem2)items[i]).GetMetadataValueEscaped("OriginalItemSpec");
+                if (original.Length == 0) { item.RemoveMetadata("OriginalItemSpec"); }
+                else { item.SetMetadata("OriginalItemSpec", original); }
+                result[i] = item;
+            }
+            return result;
+        }
+        return value;
+    }
