<Project>
  <PropertyGroup>
    <_NativeTranslationCompletion>$(IntermediateOutputPath)$(MSBuildProjectFile).NativeTranslations.complete</_NativeTranslationCompletion>
    <_NativeTranslationInputsCache>$(IntermediateOutputPath)$(MSBuildProjectFile).NativeTranslations.inputs.cache</_NativeTranslationInputsCache>
  </PropertyGroup>
  <ItemGroup>
    <FileWrites Include="$(_NativeTranslationCompletion);$(_NativeTranslationInputsCache)" />
    <NativeNonCoreProducts Include="$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_NativeTranslationCompletion)'));
                                   $([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_NativeTranslationInputsCache)'))" />
  </ItemGroup>

  <!-- Keep preparation in the body so BeforeTargets hooks populate their inputs first. -->
  <Target Name="CopyPackageTranslationFiles" AfterTargets="Build">
    <CallTarget Targets="_NativePrepareTranslations;_NativeIncrementalTranslations;_NativeFallbackTranslations" />
  </Target>

  <Target Name="_NativePrepareTranslations">
    <ItemGroup>
      <_NativeTranslationDestinations Include="@(PackageTranslationFiles->'Localization\%(RecursiveDir)%(Filename)%(Extension)')" />
      <_NativeMissingTranslations Include="@(_NativeTranslationDestinations)" Condition="!Exists('%(Identity)')" />
      <_NativeTranslationMapping Include="@(PackageTranslationFiles->'%(FullPath)|%(RecursiveDir)|%(Filename)%(Extension)')" />
    </ItemGroup>
    <Hash ItemsToHash="@(_NativeTranslationMapping)" IgnoreCase="false">
      <Output TaskParameter="HashResult" PropertyName="_NativeTranslationMappingHash" />
    </Hash>
    <WriteLinesToFile File="$(_NativeTranslationInputsCache)" Lines="$(_NativeTranslationMappingHash)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="_NativeIncrementalTranslations"
          Condition="'$(_NativeCompletion)' != '' and '@(PackageTranslationFiles)' != ''"
          Inputs="@(PackageTranslationFiles);@(_NativeTranslationDestinations);$(_NativeCompletion);$(_NativeTranslationInputsCache)"
          Outputs="$(_NativeTranslationCompletion);@(_NativeMissingTranslations)"
          Returns="">
    <CallTarget Targets="_NativeCopyTranslationProducts" />
    <Touch Files="$(_NativeTranslationCompletion)" AlwaysCreate="true" />
    <OnError ExecuteTargets="_NativeInvalidateTranslations" />
  </Target>

  <Target Name="_NativeFallbackTranslations"
          Condition="'$(_NativeCompletion)' == '' or '@(PackageTranslationFiles)' == ''">
    <CallTarget Targets="_NativeCopyTranslationProducts" />
  </Target>

  <Target Name="_NativeCopyTranslationProducts">
    <Message Text="Copying translation files: $(MSBuildProjectName)" Importance="high" />
    <Copy SourceFiles="@(PackageTranslationFiles->'%(FullPath)')"
          DestinationFiles="@(PackageTranslationFiles->'Localization\%(RecursiveDir)%(Filename)%(Extension)')"
          Condition="'@(PackageTranslationFiles)' != ''"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="false" />
  </Target>

  <Target Name="_NativeInvalidateTranslations">
    <Delete Files="$(_NativeTranslationCompletion);$(_NativeTranslationInputsCache)" />
  </Target>

  <Target Name="_NativeCleanTranslations" AfterTargets="CoreClean">
    <Delete Files="$(_NativeTranslationCompletion);$(_NativeTranslationInputsCache)" />
  </Target>
</Project>
