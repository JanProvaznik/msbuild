<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType><EnableSourceLink>false</EnableSourceLink></PropertyGroup>
  <ItemGroup><ProjectReference Include="../Producer/Producer.csproj" /></ItemGroup>
  <Target Name="GenerateSharedSources" BeforeTargets="PreBuildEvent">
    <Message Text="GENERATING-PRODUCER-SOURCE" Importance="high" />
    <WriteLinesToFile File="../Producer/Generated.cs" Lines="public static class Generated { public static int Value => 42%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
