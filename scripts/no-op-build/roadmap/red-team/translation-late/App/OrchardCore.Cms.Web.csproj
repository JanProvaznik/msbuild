<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableSourceLink>false</EnableSourceLink>
    <DefaultItemExcludes>$(DefaultItemExcludes);Localization/**</DefaultItemExcludes>
    <TranslationVersion Condition="'$(TranslationVersion)' == ''">v1</TranslationVersion>
  </PropertyGroup>
  <Target Name="DiscoverTranslationPackage" BeforeTargets="BeforeBuild">
    <ItemGroup><PackageTranslationFiles Include="../packages/$(TranslationVersion)/**/*.po" /></ItemGroup>
    <Message Text="MAPPING: @(PackageTranslationFiles) SIGNATURE: @(NativeAdditionalInputSignature)" Importance="high" />
  </Target>
  <Target Name="CopyPackageTranslationFiles" AfterTargets="Build">
    <Copy SourceFiles="@(PackageTranslationFiles)" DestinationFiles="@(PackageTranslationFiles->'Localization/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="false" />
  </Target>
</Project>
